# ─────────────────────────────────────────────────────────────────
#  ArtCurve Backend — Environment Variables
#  Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
APP_DOMAIN=localhost
APP_URI=http://localhost:3001

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://artcurve:artcurve@localhost:5432/artcurve_db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=artcurve
DB_PASSWORD=artcurve
DB_NAME=artcurve_db
DB_POOL_MAX=20
DB_POOL_MIN=2

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=artcurve
CLICKHOUSE_PASSWORD=artcurve_ch_pass
CLICKHOUSE_DB=artcurve_analytics

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT
JWT_SECRET=change-me-in-production-use-256-bit-random-string
JWT_EXPIRES_IN=7d

# Blockchain
CHAIN_ID=8453
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
WS_RPC_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
INDEXER_START_BLOCK=0

# Contract addresses (fill after deployment)
ART_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
BONDING_CURVE_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_ART_FACTORY_SEPOLIA=0x0000000000000000000000000000000000000000
CONTRACT_BONDING_CURVE_SEPOLIA=0x0000000000000000000000000000000000000000
CONTRACT_ART_FACTORY_BASE=0x0000000000000000000000000000000000000000
CONTRACT_BONDING_CURVE_BASE=0x0000000000000000000000000000000000000000

# IPFS / Pinata
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# AI Moderation (optional — skipped if not set)
OPENAI_API_KEY=

# Google Vision AI (legacy NSFW — optional)
GOOGLE_VISION_API_KEY=
NSFW_SCORE_THRESHOLD=0.7

# Internal Service Security
INTERNAL_SERVICE_KEY=change_me_to_random_secret

# Observability (optional) — error tracking
SENTRY_DSN=

# Prometheus scrape: GET /api/v1/metrics (khong can config)

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

# OAuth — Telegram (optional)
TELEGRAM_BOT_TOKEN=

# LiveKit (real-time streaming)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud

# Gemini AI (guild chat — optional)
GEMINI_API_KEY=
