# ─────────────────────────────────────────────────────────────────────────────
#  ArtCurve Contracts — Environment Variables
#  Copy file này thành .env và điền giá trị thực.
#  KHÔNG bao giờ commit file .env vào Git!
# ─────────────────────────────────────────────────────────────────────────────

# ── RPC Endpoints ─────────────────────────────────────────────────────────────
# Lấy từ Alchemy / Infura / QuickNode / Ankr

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Deployer ──────────────────────────────────────────────────────────────────
# Khóa riêng tư của ví deployer (KHÔNG dùng ví chứa tiền thật trên testnet).
# Định dạng: 64 hex chars, KHÔNG có tiền tố 0x.
# Ví dụ (testnet only, KHÔNG dùng cho mainnet):
PRIVATE_KEY=your_private_key_without_0x_prefix

# ── Admin / Multisig ──────────────────────────────────────────────────────────
# Địa chỉ ví nhận quyền Owner của ArtFactory sau khi deploy.
# KHUYẾN NGHỊ MAINNET: Dùng Gnosis Safe multisig (2-of-3 hoặc 3-of-5).
# TESTNET: Có thể dùng cùng ví với deployer.
ADMIN_ADDRESS=0xYourAdminOrMultisigAddress

# ── Platform Treasury ─────────────────────────────────────────────────────────
# Địa chỉ ví nhận platform fee từ mỗi giao dịch mua/bán trên bonding curve.
# Nên là multisig hoặc ví cold storage riêng biệt với ADMIN_ADDRESS.
# TESTNET: Có thể dùng cùng ví với deployer hoặc admin.
PLATFORM_TREASURY_ADDRESS=0xYourPlatformTreasuryAddress

# ── Fee Configuration ─────────────────────────────────────────────────────────
# Đơn vị: basis points (bps). 100 bps = 1%.
# Tổng (PLATFORM_FEE_BPS + DEFAULT_CREATOR_FEE_BPS) <= 1000 (10%).
# Ví dụ: Platform 2% + Creator 1% = 3% total fee per trade.

PLATFORM_FEE_BPS=200
# Platform fee rate: 200 bps = 2%

DEFAULT_CREATOR_FEE_BPS=100
# Default creator fee: 100 bps = 1%
# Creator có thể override khi gọi createArtwork(metadataCID, targetCap, creatorFeeRate)
# nếu truyền creatorFeeRate > 0 (miễn tổng fee <= 10%)

# ── Etherscan API Key (dùng cho --verify) ────────────────────────────────────
# Lấy từ https://etherscan.io/myapikey (Ethereum)
# Hoặc https://basescan.org/myapikey (Base)
ETHERSCAN_API_KEY=your_etherscan_api_key

# ─────────────────────────────────────────────────────────────────────────────
#  Sau khi deploy, thêm các địa chỉ contract vào đây để frontend/backend dùng:
# ─────────────────────────────────────────────────────────────────────────────

# ARTFRACTION_TOKEN_IMPL=0x...    # ArtFractionToken implementation
# BONDING_CURVE_AMM_IMPL=0x...    # BondingCurveAMM implementation
# ART_FACTORY_ADDRESS=0x...       # ArtFactory (địa chỉ này Backend cần nhất)

# ─────────────────────────────────────────────────────────────────────────────
#  Ví dụ lệnh forge script (sau khi điền .env đầy đủ):
#
#  [Dry-run — không broadcast, chỉ simulate]:
#    forge script script/Deploy.s.sol --rpc-url $SEPOLIA_RPC_URL -vvvv
#
#  [Deploy to Sepolia + verify on Etherscan]:
#    forge script script/Deploy.s.sol \
#      --rpc-url $SEPOLIA_RPC_URL \
#      --broadcast \
#      --verify \
#      --etherscan-api-key $ETHERSCAN_API_KEY \
#      -vvvv
#
#  [Deploy to Mainnet (THẬN TRỌNG)]:
#    forge script script/Deploy.s.sol \
#      --rpc-url $MAINNET_RPC_URL \
#      --broadcast \
#      --verify \
#      --etherscan-api-key $ETHERSCAN_API_KEY \
#      --slow \
#      -vvvv
# ─────────────────────────────────────────────────────────────────────────────
