{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      { "include": "shared/clickhouse/schema.sql",     "outDir": "dist/shared/clickhouse" },
      { "include": "shared/curve-engine/curve.proto",  "outDir": "dist/shared/curve-engine" }
    ],
    "watchAssets": true
  }
}
