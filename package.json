{
  "name": "artcurve-database",
  "version": "0.1.0",
  "description": "ARTCURVE — Fractionalized Art Trading DApp Backend (NestJS + TypeORM + PostgreSQL)",
  "scripts": {
    "build": "tsc -p tsconfig.json --skipLibCheck",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:railway": "npm run build && node dist/main",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run      -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert   -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show     -d src/database/data-source.ts",
    "seed": "ts-node src/database/seeds/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.18.5",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.4.22",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.3",
    "axios": "^1.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.0.3",
    "ethers": "^6.11.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^18.2.1",
    "livekit-server-sdk": "^2.15.4",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "siwe": "^3.0.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0",
    "viem": "^2.49.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/amqplib": "^0.10.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.2",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
